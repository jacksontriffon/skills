{
  "$schema": "./kitchen/kitchen.schema.json",
  "repo": "{{REPO}}",
  "packageManager": "{{PACKAGE_MANAGER}}",
  "workspaceTool": "{{WORKSPACE_TOOL}}",
  "humans": {
    "default": "{{HUMAN}}"
  },
  "expo": {
    "appDir": "{{APP_DIR}}",
    "routesDir": "{{ROUTES_DIR}}",
    "appId": "{{APP_ID}}",
    "scheme": "{{SCHEME}}",
    "nativeDirs": "{{NATIVE_DIRS}}"
  },
  "flows": ".maestro",
  "design": "docs/design"
}
