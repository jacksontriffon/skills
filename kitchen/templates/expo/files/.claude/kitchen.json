{
  "$schema": "./kitchen/kitchen.schema.json",
  "repo": "{{REPO}}",
  "packageManager": "{{PACKAGE_MANAGER}}",
  "humans": {
    "default": "{{HUMAN}}"
  },
  "expo": {
    "appDir": "{{APP_DIR}}",
    "routesDir": "{{ROUTES_DIR}}",
    "appId": "{{APP_ID}}",
    "scheme": "{{SCHEME}}",
    "nativeDirs": "{{NATIVE_DIRS}}"
  },
  "flows": ".maestro",
  "design": "docs/design",
  "adapters": {
    "stack": { "use": "supabase-local" },
    "db": { "use": "supabase-migrations" },
    "auth": { "use": "supabase-auth" },
    "errors": { "use": "none" },
    "evidenceHost": { "use": "git-branch" }
  }
}
