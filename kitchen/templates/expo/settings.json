{
  "permissions": {
    "allow": [
      "Bash(node .claude/kitchen/scripts/*)",
      "Bash(bash .claude/kitchen/scripts/*)",
      "Bash(.claude/kitchen/scripts/*)",
      "Bash(.claude/kitchen/adapters/*)",
      "Bash(.claude/scripts/sync-skills.sh*)",
      "Bash({{PACKAGE_MANAGER}} kitchen:doctor)",
      "Bash({{PACKAGE_MANAGER}} drive*)",
      "Bash({{PACKAGE_MANAGER}} test:scripts)",
      "Bash(git *)",
      "Bash(gh *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/kitchen/scripts/kitchen.mjs brief"
          }
        ]
      }
    ]
  }
}
