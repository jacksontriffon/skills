#!/usr/bin/env bash
# Stop the app `up` started, with everything under it, and forget its URL. Quiet when nothing runs.
set -euo pipefail

# shellcheck source=../../lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/../../lib.sh"

PID_FILE="$STATE_DIR/dev-server.api.pid"

if [[ -f "$PID_FILE" ]]; then
  pid="$(cat "$PID_FILE")"
  # pid names the process group, so this also reaches next-server, five levels under the
  # package manager through turbo, dotenv and next.
  kill -- -"$pid" 2>/dev/null || true
  waited=0
  while kill -0 -- -"$pid" 2>/dev/null && ((waited < 50)); do
    sleep 0.1
    waited=$((waited + 1))
  done
  kill -s KILL -- -"$pid" 2>/dev/null || true
  rm -f "$PID_FILE"
fi
rm -f "$STATE_DIR/dev-server.api.url"
