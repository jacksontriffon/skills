#!/usr/bin/env bash
# Host a PR's shots on the evidence/<pr> branch and print the URL of each.
#
#   .claude/kitchen/scripts/adapter.mjs evidenceHost push <pr> <dir>
#   .claude/kitchen/scripts/push-shots.sh <pr> <dir>        # the same, the name the workflows and docs use
#
# Prints one `<name>.png<TAB><url>` line per PNG in <dir>, on stdout. The URL is pinned
# to the commit this push made, so a later lap's push never changes what an earlier
# comment shows. It renders for anyone signed in to a repo that can read the branch.
#
# It pushes only to an origin that is kitchen.json's repo, and prints that repo's URLs. A
# repository renamed on GitHub keeps answering to its old name, so an origin left on the old
# name would push and print URLs a sanitizer treats as foreign; this fails instead, before
# writing anything.
#
# Plumbing rather than a checkout, so the working tree is untouched: a blob per shot, a
# tree holding them under <pr>/, and a commit of that tree. The first push has no parent;
# a later one takes the branch's tip as its parent, so the old commit stays reachable
# and the push is a fast-forward. A later push also keeps the files the tip already holds
# under <pr>/, replacing one only when a shot of the same name is pushed, so a second push
# never drops the first push's shots from the branch.
#
# A bare `evidence` branch cannot exist next to `evidence/<n>`: git refuses the ref
# directory/file conflict.
set -euo pipefail

export GIT_AUTHOR_NAME="${GIT_AUTHOR_NAME:-evidence}" GIT_AUTHOR_EMAIL="${GIT_AUTHOR_EMAIL:-evidence@users.noreply.github.com}"
export GIT_COMMITTER_NAME="${GIT_COMMITTER_NAME:-$GIT_AUTHOR_NAME}" GIT_COMMITTER_EMAIL="${GIT_COMMITTER_EMAIL:-$GIT_AUTHOR_EMAIL}"

pr="${1:?usage: adapter.mjs evidenceHost push <pr> <dir>}"
dir="${2:?usage: adapter.mjs evidenceHost push <pr> <dir>}"
branch="evidence/$pr"

repo="$(node "$(dirname "${BASH_SOURCE[0]}")/../../../scripts/kitchen.mjs" get repo)"
origin_url="$(git config --get remote.origin.url || true)"
origin_repo="$(printf '%s' "$origin_url" | sed -E 's#(\.git)?/?$##; s#.*[:/]([^/]+/[^/]+)$#\1#')"
if [[ "${origin_repo,,}" != "${repo,,}" ]]; then
  echo "push-shots: origin is '$origin_url', which is not $repo, the repo kitchen.json names. Nothing was pushed. Point origin at $repo and run it again." >&2
  exit 1
fi

shots=("$dir"/*.png)
[[ -e "${shots[0]}" ]] || { echo "no PNG in $dir" >&2; exit 1; }

parent=()
kept=""
if git fetch -q origin "$branch" 2>/dev/null; then
  parent=(-p FETCH_HEAD)
  kept="$(git ls-tree FETCH_HEAD:"$pr" 2>/dev/null || true)"
fi

entries=""
declare -A pushed=()
for shot in "${shots[@]}"; do
  name="$(basename "$shot")"
  pushed[$name]=1
  blob="$(git hash-object -w "$shot")"
  entries+=$'100644 blob '"$blob"$'\t'"$name"$'\n'
done
while IFS= read -r line; do
  if [[ -n "$line" && -z "${pushed[${line#*$'\t'}]:-}" ]]; then
    entries+="$line"$'\n'
  fi
done <<<"$kept"
inner="$(printf '%s' "$entries" | git mktree)"
tree="$(printf '040000 tree %s\t%s\n' "$inner" "$pr" | git mktree)"

commit="$(git commit-tree "$tree" "${parent[@]}" -m "📸 evidence(#$pr): shots")"
git push -q origin "$commit:refs/heads/$branch"

for shot in "${shots[@]}"; do
  name="$(basename "$shot")"
  printf '%s\thttps://github.com/%s/blob/%s/%s/%s?raw=true\n' "$name" "$repo" "$commit" "$pr" "$name"
done
